# Sillok 환경변수 계약 (D16)
#
# 정본: adr/0001-v1-stack-decisions.md §D16 환경변수 계약 — 값이 다르면 정본이 이긴다.
# 복사해서 .env 로 쓴다. .env 는 .gitignore 에 있다. 비밀키를 레포에 커밋하지 않는다.

# --- 앱 ---------------------------------------------------------------------

# 앱 DSN. 하나의 URL 로 둔다. PGHOST/PGPORT 로 쪼개지 않는다.
# Compose 의 api 는 호스트를 db 로 덮는다: postgresql://sillok:sillok@db:5432/sillok
DATABASE_URL=postgresql://sillok:sillok@127.0.0.1:5432/sillok

# bind 주소. Compose 의 api 는 SILLOK_HOST=0.0.0.0 으로 덮어야
# 호스트의 127.0.0.1:8080 에 닿는다. 클라이언트가 쓰는 주소는 그대로 127.0.0.1:8080.
SILLOK_HOST=127.0.0.1
SILLOK_PORT=8080

# get_file 이 읽는 workspace 루트 (D4).
# project -> 경로 매핑은 아직 미정이다 (Q20). 지금은 루트 하나만 정해져 있다.
SILLOK_WORKSPACE=.

# 빈 값이면 로컬 무인증 (D7).
# 값이 있으면 모든 HTTP 요청에 Authorization: Bearer <token> 를 요구한다.
SILLOK_BEARER_TOKEN=

# 빈 값이면 embedding 은 NULL 이고 tsv 키워드 검색만 동작한다 (D2).
# 실제 키를 여기 적지 않는다 — .env 에만 넣는다.
OPENAI_API_KEY=

# --- Compose 의 db 컨테이너 -------------------------------------------------
# 아래는 앱이 읽는 변수가 아니라 Postgres 이미지의 초기화 계약이다.
# DATABASE_URL 의 사용자/암호/DB 이름과 반드시 일치시킨다.

POSTGRES_USER=sillok
POSTGRES_PASSWORD=sillok
POSTGRES_DB=sillok

# 5432 를 호스트에 게시하지 않는다. Compose 위생이지 D19 가 강제하는 것은 아니다 —
# D19 가 금지하는 것은 CLI 가 자기 SQL 계층을 갖는 것이고,
# 게시된 포트가 여는 것은 사람이 psql 로 들어오는 길이다.
#
# 그래서 위의 DATABASE_URL 기본값(127.0.0.1:5432)이 닿는 경우는 둘뿐이다:
#   1) Compose 없이 로컬 Postgres 를 직접 띄운 경우
#   2) 디버깅하려고 일시적으로 5432 를 게시한 경우
# sillok ingest 는 5단계에서 생겼다. Compose 안에서 부른다:
#   docker compose exec api sillok ingest --project <name>
# 다만 그 형태가 도는지는 확인하지 않았다 — Dockerfile 이 가상환경 경로를 PATH 에
# 넣지 않는다 (D30 이 지적한 자리). pytest 의 DB 검사는 호스트에서 돌므로
# 5432 게시가 필요할 수 있다 — 커밋된 구성에서 전부 돌리는 방법은 D22 의
# `docker compose --profile test run --rm test` 다.
